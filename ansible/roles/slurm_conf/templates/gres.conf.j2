# GPU Resource Configuration for SLURM
# Generated by Ansible - DO NOT EDIT MANUALLY

{% if ansible_architecture == 'aarch64' %}
# ARM64 architecture: NVML plugin not available, use explicit device mappings
AutoDetect=off
{% for node in groups['slurm_compute_nodes'] %}
{% if hostvars[node].gpu_count is defined %}
{% for gpu_id in range(hostvars[node].gpu_count | int) %}
NodeName={{ node }} Name=gpu File=/dev/nvidia{{ gpu_id }}
{% endfor %}
{% endif %}
{% endfor %}
{% else %}
# x86_64 architecture: Use NVML auto-detection
AutoDetect=nvml
{% endif %}
